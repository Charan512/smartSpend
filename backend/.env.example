# ─────────────────────────────────────────────────
# Smart Spend — Environment Configuration
# Copy this file to .env (backend) and .env.local (frontend)
# ─────────────────────────────────────────────────

# --- Backend Settings ---
# development | production
# NOTE: JWT_SECRET is only optional when ENVIRONMENT=development.
#       All other values (staging, test, production, unset) REQUIRE JWT_SECRET to be set.
ENVIRONMENT=development

# Database Configuration
# Local Dev (SQLite): sqlite:///./expenses.db
# Cloud DB (PostgreSQL/Neon/Supabase): postgresql://user:password@host/dbname
DATABASE_URL=sqlite:///./expenses.db

# JWT Authentication
# Generate a secret: python -c "import secrets; print(secrets.token_hex(32))"
# Required for all environments except ENVIRONMENT=development
JWT_SECRET=change-me-to-a-long-random-secret-in-production

# Scheduler Settings
RUN_SCHEDULER=true

# CORS Configuration (comma-separated list of allowed origins)
# In development, the server defaults to http://localhost:3000 and http://127.0.0.1:3000
# In production, this variable is REQUIRED.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# API Settings
API_HOST=0.0.0.0
API_PORT=8000
